# Copie para .env e preencha. O .env nunca vai para o Git nem é sobrescrito no deploy.

# Servidor (no Oracle o nginx faz o proxy para esta porta local)
PORT=3010
HOST=127.0.0.1

# true quando a plataforma é acessada por HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SECURE=false

# Token de acesso da Meta (permissão ads_read). Também pode ser trocado pela tela Configurações.
META_ACCESS_TOKEN=

# Opcional: com o ID e a chave secreta do app, tokens curtos colados na interface
# são convertidos automaticamente para tokens de ~60 dias.
META_APP_ID=
META_APP_SECRET=

# Versão da Graph API
META_API_VERSION=v26.0

# Fuso usado para calcular "hoje", "últimos 7 dias" etc.
TIMEZONE=America/Sao_Paulo

# Tempo (s) que os dados da Meta ficam em cache no servidor. O botão "Atualizar" ignora o cache.
CACHE_TTL_SECONDS=300

# Opcional: segredo das sessões. Se vazio, é gerado e guardado em data/secret.json.
SESSION_SECRET=
